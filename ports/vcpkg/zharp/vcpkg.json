{
  "name": "zharp",
  "version": "0.1.0",
  "description": "Zharp for C and C++: crash reports through Crashpad, handled errors, breadcrumbs, logs and traces.",
  "homepage": "https://zharp.io/docs/sdks/native",
  "license": "MIT AND Apache-2.0",
  "supports": "windows | osx | linux",
  "dependencies": [
    {
      "name": "curl",
      "platform": "!windows"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "qt": {
      "description": "The Qt layer, zharp::qt: Qt log messages, screens and QNetworkAccessManager spans (Qt 6)",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "network"
          ]
        }
      ]
    }
  }
}
